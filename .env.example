# Copy to .env.local for local development. On Vercel, set these under Settings → Environment Variables.

# Postgres connection string (set automatically by the Vercel Neon integration).
DATABASE_URL=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Who may sign in: Google emails separated by commas.
ALLOWED_EMAILS=

# Optional: email shown on the privacy page for data requests.
# CONTACT_EMAIL=you@example.com

# Optional: the public URL, so Google always redirects back to the same domain.
# APP_URL=https://your-app.vercel.app
